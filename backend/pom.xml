<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.12</version>
        <relativePath/>
    </parent>

    <groupId>com.pharos</groupId>
    <artifactId>compliance-dashboard-api</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>Pharos Compliance Dashboard API</name>

    <properties>
        <java.version>21</java.version>
        <prince-of-space.version>2.2.0</prince-of-space.version>
        <spotless-maven-plugin.version>3.10.0</spotless-maven-plugin.version>
        <!-- jOOQ codegen connects at build time only, to read the schema; the app itself still
             connects only through the HikariDataSource built in DatabaseConfiguration. Same
             defaults as application.yml's common.postgres.* so a plain local build works
             untouched; override with -Djooq.codegen.jdbc.* for CI or a different database, the
             same way DB_URL/DB_USER/DB_PASSWORD override application.yml. -->
        <jooq.codegen.jdbc.url>jdbc:postgresql://localhost:5439/pharosRBT</jooq.codegen.jdbc.url>
        <jooq.codegen.jdbc.user>pharosRBT</jooq.codegen.jdbc.user>
        <jooq.codegen.jdbc.password>pharosRBT</jooq.codegen.jdbc.password>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jooq</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.9</version>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-brave</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <!-- Generates typed table/field classes from the live pharos schema so query
                     construction is compile-checked, replacing Spring Data's reflective
                     alias-to-getter binding. Version is inherited from spring-boot-starter-parent's
                     dependency management (jOOQ 3.19.28 as of Boot 3.4.12); do not pin it here, or
                     codegen and the jOOQ runtime classpath can silently drift apart. -->
                <groupId>org.jooq</groupId>
                <artifactId>jooq-codegen-maven</artifactId>
                <executions>
                    <execution>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
                <dependencies>
                    <!-- The plugin's classpath is isolated from the project's own dependencies, so
                         the JDBC driver it connects with has to be declared again here. -->
                    <dependency>
                        <groupId>org.postgresql</groupId>
                        <artifactId>postgresql</artifactId>
                        <version>${postgresql.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <jdbc>
                        <driver>org.postgresql.Driver</driver>
                        <url>${jooq.codegen.jdbc.url}</url>
                        <user>${jooq.codegen.jdbc.user}</user>
                        <password>${jooq.codegen.jdbc.password}</password>
                    </jdbc>
                    <generator>
                        <database>
                            <name>org.jooq.meta.postgres.PostgresDatabase</name>
                            <inputSchema>pharos</inputSchema>
                        </database>
                        <target>
                            <packageName>com.pharos.compliance.jooq</packageName>
                            <directory>target/generated-sources/jooq</directory>
                        </target>
                    </generator>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless-maven-plugin.version}</version>
                <configuration>
                    <java>
                        <princeOfSpace>
                            <version>${prince-of-space.version}</version>
                            <indentStyle>SPACES</indentStyle>
                            <indentSize>2</indentSize>
                            <lineLength>140</lineLength>
                            <wrapStyle>WIDE</wrapStyle>
                            <closingParenOnNewLine>false</closingParenOnNewLine>
                            <trailingCommas>false</trailingCommas>
                            <javaLanguageLevel>21</javaLanguageLevel>
                        </princeOfSpace>
                        <removeUnusedImports/>
                        <formatAnnotations/>
                    </java>
                    <formats>
                        <format>
                            <includes>
                                <include>pom.xml</include>
                                <include>src/**/*.yml</include>
                                <include>src/**/*.yaml</include>
                            </includes>
                            <trimTrailingWhitespace/>
                            <endWithNewline/>
                        </format>
                    </formats>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
